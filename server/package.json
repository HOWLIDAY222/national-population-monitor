{
  "name": "population-platform-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "collect": "node src/cli/collect.js",
    "status": "node src/cli/status.js",
    "review": "node src/cli/review.js",
